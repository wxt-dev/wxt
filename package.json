{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run cspell-order:check && check && bun run --sequential --workspaces check",
    "cspell-order:check": "bun run scripts/check-cspell-order.ts",
    "cspell-order:format": "bun run scripts/format-cspell-order.ts",
    "test": "bun run --workspaces test run",
    "test:coverage": "bun run --workspaces test:coverage",
    "prepare": "simple-git-hooks",
    "docs:gen": "typedoc --options docs/typedoc.json",
    "docs:dev": "bun run --silent docs:gen && bun run --bun vitepress dev docs",
    "docs:build": "bun run --silent docs:gen && bun run --bun vitepress build docs",
    "docs:preview": "bun run --silent docs:gen && bun run --bun vitepress preview docs"
  },
  "devDependencies": {
    "@aklinker1/buildc": "catalog:",
    "@aklinker1/check": "catalog:",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "catalog:",
    "@types/markdown-it-footnote": "^3.0.4",
    "@vitest/coverage-v8": "catalog:",
    "consola": "^3.4.2",
    "cspell": "^10.4.0",
    "feed": "^6.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdownlint-cli": "^0.49.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.78.0",
    "p-map": "^7.0.4",
    "puppeteer-core": "^25.17.0",
    "simple-git-hooks": "^2.14.0",
    "tinyexec": "catalog:",
    "tinyglobby": "^0.2.16",
    "tsdown": "catalog:",
    "tsx": "4.21.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-frontmatter": "^1.3.2",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "catalog:",
    "verkit": "^0.5.0",
    "vitepress": "^1.6.4",
    "vitepress-knowledge": "^0.4.1",
    "vitepress-mermaid-renderer": "^1.2.2",
    "vitepress-plugin-group-icons": "^1.7.3",
    "vitepress-plugin-llms": "^1.15.0",
    "vitest-mock-extended": "^5.1.1",
    "vue": "^3.5.34",
    "wxt": "workspace:*"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "catalog": {
    "@aklinker1/buildc": "^1.1.7",
    "@aklinker1/check": "^2.4.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@webext-core/fake-browser": "^1.3.4",
    "oxlint": "^1.63.0",
    "publint": "^0.3.18",
    "tinyexec": "^1.2.4",
    "tsdown": "^0.21.0",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-plugin-random-seed": "^2.0.2",
    "web-ext": "^10.5.0"
  },
  "patchedDependencies": {
    "markdown-it-footnote@4.0.0": "patches/markdown-it-footnote.patch"
  }
}
