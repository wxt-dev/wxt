{
  "name": "@wxt-dev/module-solid",
  "version": "1.1.4",
  "description": "WXT module to enable SolidJS support",
  "keywords": [
    "module",
    "solidjs",
    "wxt"
  ],
  "homepage": "https://github.com/wxt-dev/wxt/blob/main/packages/module-solid/README.md",
  "license": "MIT",
  "author": {
    "name": "Aaron Klinker",
    "email": "aaronklinker1+wxt@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxt-dev/wxt.git",
    "directory": "packages/module-solid"
  },
  "funding": "https://github.com/sponsors/wxt-dev",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "dev": "wxt",
    "check": "bun run build && check",
    "build": "buildc -- tsdown",
    "postinstall": "buildc --deps-only -- wxt prepare",
    "test": "echo 'noop'",
    "test:coverage": "echo 'noop'",
    "prepack": "bun run build"
  },
  "dependencies": {
    "vite-plugin-solid": "^2.11.10"
  },
  "devDependencies": {
    "@aklinker1/buildc": "catalog:",
    "publint": "catalog:",
    "solid-js": "^1.9.11",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "wxt": "workspace:*"
  },
  "peerDependencies": {
    "wxt": ">=0.19.16"
  }
}
